{
  "info": {
    "name": "Proyecto 2 - Usuarios Productos Ventas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API local real. Ejecutar en orden. Las pruebas crean sus propios registros y los eliminan al finalizar; conservan los datos masivos. Credenciales en el entorno privado Local.local.json. Importes en centavos de GTQ. Contrato de referencia: frontend/openapi.json."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_id')) pm.collectionVariables.set('run_id',Date.now().toString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Pública usuarios paginados",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/public/users",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON',()=>pm.response.to.be.json);",
              "pm.test('10 por página y 100k usuarios',()=>{let j=pm.response.json();pm.expect(j.data).to.have.lengthOf(10);pm.expect(j.meta.total).to.be.at.least(100000);}); pm.test('Sin contraseñas ni correos privados',()=>{pm.response.json().data.forEach(u=>{pm.expect(u).not.to.have.property('password');pm.expect(u).not.to.have.property('email');});});"
            ]
          }
        }
      ]
    },
